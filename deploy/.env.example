# Copia este archivo como .env en la RAIZ del repositorio (en el servidor) y cambia los valores.
# Evita el caracter $ en las claves. Para generar claves:  openssl rand -hex 24

# Direccion publica, SIN https:// (ej. umedical-demo.duckdns.org)
DOMAIN=umedical-demo.duckdns.org

# Contrasenas de MySQL (la de root y la del usuario de la aplicacion)
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_PASSWORD=cambia_esta_clave_app

# Secreto con el que se firman los tokens JWT (minimo 32 caracteres)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Origenes permitidos (CORS): tu dominio + la app movil (Capacitor). Debe coincidir con DOMAIN.
CORS_ALLOWED_ORIGINS=https://umedical-demo.duckdns.org,http://localhost:[*],https://localhost:[*],capacitor://localhost

CLINIC_TIMEZONE=America/Guatemala
